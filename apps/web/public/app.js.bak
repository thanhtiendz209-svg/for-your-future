              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-mist text-muted border border-line">
                ${sd.region}
              </span>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-semibold">
