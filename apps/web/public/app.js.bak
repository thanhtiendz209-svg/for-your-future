              </span>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-blue-100 text-blue-800 font-semibold">
                <i data-lucide="file-text" class="size-3"></i> ${sd.programs.length} dòng xét tuyển
              </span>
            </div>
            <div class="mt-3 flex flex-wrap gap-3 text-xs">
              ${sd.website ? `<a href="${sd.website}" target="_blank" class="inline-flex items-center gap-1 text-azure hover:text-navy font-medium"><i data-lucide="globe" class="size-3.5"></i>Trang chủ</a>` : ''}
              ${sd.admissionsUrl ? `<a href="${sd.admissionsUrl}" target="_blank" class="inline-flex items-center gap-1 text-azure hover:text-navy font-medium"><i data-lucide="external-link" class="size-3.5"></i>Trang tuyển sinh</a>` : ''}
