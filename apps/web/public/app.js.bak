  container.innerHTML = `
    <div class="hero-wash border-b border-line">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-azure">Hồ sơ học sinh</p>
