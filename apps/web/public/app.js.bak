                    <option value="2026">2026</option>
                  </select>
                </label>
              </div>
              <button
                id="btn-ai-submit"
                type="button"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-[14px] bg-navy text-paper font-semibold text-sm hover:bg-navy-deep cta-glow transition-all duration-150 disabled:opacity-50 disabled:pointer-events-none shadow-md"
              >
                <i data-lucide="sparkles" class="size-4 text-cyan-soft"></i>
                <span id="btn-ai-submit-text">Phân tích & Lập chiến lược</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Side Pipeline Architecture Card -->
        <div class="lg:col-span-4 space-y-4">
          <div class="rounded-[24px] bg-card p-5 shadow-border border border-line">
            <h3 class="font-display text-sm font-bold text-navy dark:text-cyan-soft flex items-center gap-2 mb-3">
