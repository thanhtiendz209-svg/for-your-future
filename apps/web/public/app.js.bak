function renderConsultation(container, param) {
  let initialPrompt = '';
  if (param) {
    try {
      initialPrompt = decodeURIComponent(param);
    } catch (e) {
      initialPrompt = param;
    }
  }

  container.innerHTML = `
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="flex items-center text-xs text-muted mb-4 gap-1.5" aria-label="Breadcrumb">
        <a href="#home" class="hover:text-navy transition">Trang chủ</a>
        <span>/</span>
        <span class="text-ink font-semibold">Tư vấn AI & Phân bổ nguyện vọng</span>
      </nav>

      <!-- Page Header Banner -->
      <div class="relative overflow-hidden rounded-[28px] bg-gradient-to-r from-navy via-navy-deep to-azure p-6 sm:p-10 text-paper shadow-2xl mb-8">
