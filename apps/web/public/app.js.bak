                </div>
              </li>
            </ol>
          </div>
        </div>
      </div>

      <!-- RESULTS CONTAINER (Hidden by default, shown when user clicks submit) -->
      <div id="ai-results-wrapper" class="space-y-8 hidden">
        <!-- Live Status & Stage Pill -->
        <div id="ai-status-banner" class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-[18px] bg-ice/70 border border-azure/20 text-navy">
          <div class="flex items-center gap-2 text-sm font-semibold">
            <span class="relative flex size-2.5">
              <span id="ai-ping-ring" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-azure opacity-75"></span>
              <span class="relative inline-flex rounded-full size-2.5 bg-azure"></span>
            </span>
            <span id="ai-status-text">Đang phân tích prompt và đối chiếu đồ thị tri thức...</span>
          </div>
          <div class="text-xs text-muted flex items-center gap-1.5" id="ai-timing-badge">
            <i data-lucide="cpu" class="size-3.5"></i>
            Neo4j Graph Database + Ollama API (qwen2.5:7b)
          </div>
        </div>

        <!-- Section 1: Extracted Intent Slots -->
        <div id="ai-intent-card" class="rounded-[24px] bg-card p-5 sm:p-6 shadow-border border border-line hidden">
          <h3 class="font-display text-sm font-bold text-navy dark:text-cyan-soft mb-3 flex items-center gap-2">
            <i data-lucide="check-circle-2" class="size-4 text-emerald-600"></i>
            Thông tin hồ sơ trích xuất từ câu hỏi
          </h3>
          <div id="ai-intent-tags" class="flex flex-wrap gap-2 text-xs"></div>
        </div>

        <!-- Section 2: 3-Tier Strategic Portfolio Cards -->
        <div id="ai-portfolio-card" class="rounded-[24px] bg-card p-5 sm:p-6 shadow-border border border-line hidden">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
            <div>
              <h3 class="font-display text-lg font-bold text-navy dark:text-cyan-soft flex items-center gap-2">
                <i data-lucide="pie-chart" class="size-5 text-azure"></i>
                Chiến lược Danh mục Nguyện vọng (Admissions Portfolio)
              </h3>
              <p class="text-xs text-muted mt-1">Xếp hạng đa tiêu chí MCDM dựa trên biên độ an toàn, độ khớp Holland và thị trường việc làm CareerViet.</p>
            </div>
            <div id="ai-portfolio-counts" class="flex items-center gap-2 text-xs"></div>
          </div>

          <!-- 3 Columns for Reach, Target, Safe -->
          <div class="grid gap-6 lg:grid-cols-3">
            <!-- REACH COLUMN -->
            <div class="rounded-[20px] bg-amber-50/40 dark:bg-amber-950/10 border border-amber-200 dark:border-amber-900/40 p-4 flex flex-col">
              <div class="flex items-center justify-between pb-3 border-b border-amber-200/60 dark:border-amber-900/40 mb-3">
                <div class="flex items-center gap-2">
                  <span class="grid size-7 place-items-center rounded-lg bg-amber-500 text-white font-bold text-xs">🌟</span>
                  <div>
                    <h4 class="font-display text-sm font-bold text-amber-900 dark:text-amber-300">Vươn tầm (Reach)</h4>
                    <p class="text-[11px] text-amber-700/80 dark:text-amber-400/70">Thử thách, cơ hội bứt phá</p>
                  </div>
                </div>
                <span id="count-reach" class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">0</span>
              </div>
              <div id="list-reach" class="space-y-3 flex-1"></div>
            </div>

            <!-- TARGET COLUMN -->
            <div class="rounded-[20px] bg-blue-50/40 dark:bg-blue-950/10 border border-blue-200 dark:border-blue-900/40 p-4 flex flex-col">
              <div class="flex items-center justify-between pb-3 border-b border-blue-200/60 dark:border-blue-900/40 mb-3">
                <div class="flex items-center gap-2">
                  <span class="grid size-7 place-items-center rounded-lg bg-azure text-white font-bold text-xs">🎯</span>
                  <div>
                    <h4 class="font-display text-sm font-bold text-navy dark:text-blue-300">Trọng tâm (Target)</h4>
                    <p class="text-[11px] text-blue-700/80 dark:text-blue-400/70">Khớp nhất, biên độ +0.5 đến +2đ</p>
                  </div>
                </div>
                <span id="count-target" class="text-xs font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-800">0</span>
              </div>
              <div id="list-target" class="space-y-3 flex-1"></div>
            </div>

            <!-- SAFE COLUMN -->
            <div class="rounded-[20px] bg-emerald-50/40 dark:bg-emerald-950/10 border border-emerald-200 dark:border-emerald-900/40 p-4 flex flex-col">
              <div class="flex items-center justify-between pb-3 border-b border-emerald-200/60 dark:border-emerald-900/40 mb-3">
                <div class="flex items-center gap-2">
                  <span class="grid size-7 place-items-center rounded-lg bg-emerald-600 text-white font-bold text-xs">🛡️</span>
                  <div>
                    <h4 class="font-display text-sm font-bold text-emerald-900 dark:text-emerald-300">An toàn (Safe)</h4>
                    <p class="text-[11px] text-emerald-700/80 dark:text-emerald-400/70">Bảo hiểm vững chắc, biên độ &gt; +2đ</p>
                  </div>
                </div>
                <span id="count-safe" class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">0</span>
              </div>
              <div id="list-safe" class="space-y-3 flex-1"></div>
            </div>
          </div>
        </div>

        <!-- Section 3: Grounded AI Streaming Consultation -->
        <div id="ai-chat-card" class="rounded-[24px] bg-card p-6 sm:p-8 shadow-border border border-line hidden">
          <div class="flex items-center justify-between pb-4 border-b border-line mb-4">
            <div class="flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-[14px] bg-navy text-white shadow-md">
                <i data-lucide="bot" class="size-5 text-cyan-soft"></i>
              </span>
              <div>
                <h3 class="font-display text-base font-bold text-navy dark:text-cyan-soft flex items-center gap-2">
                  Cố vấn Tuyển sinh AI (Ollama API - qwen2.5:7b)
                  <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">Zero-Hallucination</span>
                </h3>
                <p class="text-xs text-muted">Dựa trên dữ liệu chuẩn hóa của Bộ GD&ĐT và đồ thị tuyển sinh Neo4j</p>
              </div>
            </div>
            <div id="ai-streaming-indicator" class="hidden items-center gap-1.5 text-xs text-azure font-medium">
              <span class="flex size-2 rounded-full bg-azure animate-ping"></span>
              Đang viết...
            </div>
          </div>

          <!-- Markdown Output Container -->
          <div id="ai-markdown-content" class="prose prose-sm max-w-none text-ink leading-relaxed space-y-4"></div>
        </div>
      </div>
    </div>
  `;

  setupConsultationEvents(initialPrompt);
  refreshIcons();
}

function setupConsultationEvents(initialPrompt) {
  const textarea = document.getElementById('ai-prompt-input');
  const lengthIndicator = document.getElementById('ai-prompt-length');
  const btnSubmit = document.getElementById('btn-ai-submit');
  const yearSelect = document.getElementById('ai-target-year');

  if (textarea && lengthIndicator) {
    lengthIndicator.textContent = `${textarea.value.length} ký tự`;
    textarea.addEventListener('input', () => {
      lengthIndicator.textContent = `${textarea.value.length} ký tự`;
    });
  }

  // Quick Chips click
  document.querySelectorAll('.quick-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const p = chip.getAttribute('data-prompt');
      if (textarea && p) {
        textarea.value = p;
        if (lengthIndicator) lengthIndicator.textContent = `${p.length} ký tự`;
        triggerAIStream(p);
      }
    });
  });

  // Submit button
  if (btnSubmit) {
    btnSubmit.addEventListener('click', () => {
      const p = textarea ? textarea.value.trim() : '';
      if (!p) {
        showToast('Vui lòng nhập điểm số và nguyện vọng cần tư vấn', 'warning');
        return;
      }
      triggerAIStream(p);
    });
  }

  // Auto trigger if initial prompt provided
  if (initialPrompt && initialPrompt.trim()) {
    triggerAIStream(initialPrompt.trim());
  }
}

async function triggerAIStream(promptText) {
  const resultsWrapper = document.getElementById('ai-results-wrapper');
  const statusBanner = document.getElementById('ai-status-banner');
  const statusText = document.getElementById('ai-status-text');
  const pingRing = document.getElementById('ai-ping-ring');
  const btnSubmit = document.getElementById('btn-ai-submit');
  const btnSubmitText = document.getElementById('btn-ai-submit-text');
  const intentCard = document.getElementById('ai-intent-card');
  const intentTags = document.getElementById('ai-intent-tags');
  const portfolioCard = document.getElementById('ai-portfolio-card');
  const chatCard = document.getElementById('ai-chat-card');
  const markdownContent = document.getElementById('ai-markdown-content');
  const streamingIndicator = document.getElementById('ai-streaming-indicator');
  const yearSelect = document.getElementById('ai-target-year');

  const targetYear = yearSelect ? parseInt(yearSelect.value, 10) : 2025;

  if (resultsWrapper) resultsWrapper.classList.remove('hidden');
  if (statusText) statusText.textContent = 'Đang phân tích prompt và truy vấn đồ thị tuyển sinh...';
  if (btnSubmit) btnSubmit.disabled = true;
  if (btnSubmitText) btnSubmitText.textContent = 'Đang xử lý...';

  // Reset output containers
  if (intentTags) intentTags.innerHTML = '';
  if (intentCard) intentCard.classList.add('hidden');
  if (portfolioCard) portfolioCard.classList.add('hidden');
  if (chatCard) chatCard.classList.add('hidden');
  if (markdownContent) markdownContent.innerHTML = '';

  let fullAiText = '';

  try {
    const response = await fetch('/api/v1/chat/recommend/stream', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt: promptText, target_year: targetYear }),
    });

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    const reader = response.body.getReader();
    const decoder = new TextDecoder('utf-8');
    let buffer = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n\n');
      buffer = lines.pop() || '';

      for (const block of lines) {
        const trimmed = block.trim();
        if (!trimmed || !trimmed.startsWith('data: ')) continue;
        const payload = trimmed.slice(6).trim();

        if (payload === '[DONE]') {
          if (statusText) statusText.textContent = 'Hoàn tất phân tích & tư vấn!';
          if (pingRing) pingRing.classList.remove('animate-ping');
          if (streamingIndicator) streamingIndicator.classList.remove('flex'), streamingIndicator.classList.add('hidden');
          continue;
        }

        try {
          const parsed = JSON.parse(payload);

          // Type 1: Extracted Intent
          if (parsed.type === 'intent' && parsed.data) {
            renderExtractedIntent(parsed.data);
          }

          // Type 2: Strategic Portfolio
          else if (parsed.type === 'portfolio' && parsed.data) {
            renderStrategicPortfolio(parsed.data);
          }

          // Type 3: AI Streaming Tokens
          else if (parsed.type === 'token' && parsed.token) {
            if (chatCard) chatCard.classList.remove('hidden');
            if (streamingIndicator) streamingIndicator.classList.remove('hidden'), streamingIndicator.classList.add('flex');
            if (statusText) statusText.textContent = 'Ollama AI đang trực tiếp tư vấn chiến lược...';

            fullAiText += parsed.token;
            if (markdownContent) {
              if (window.marked && typeof window.marked.parse === 'function') {
                markdownContent.innerHTML = window.marked.parse(fullAiText);
              } else {
                markdownContent.textContent = fullAiText;
              }
            }
          }
        } catch (e) {
          // Non-JSON SSE line or formatting fallback
        }
      }
    }
  } catch (err) {
    console.error('Lỗi khi gọi luồng tư vấn GraphRAG:', err);
    if (statusText) statusText.textContent = 'Có lỗi xảy ra trong quá trình kết nối tới AI. Vui lòng thử lại!';
    showToast('Lỗi kết nối tới máy chủ GraphRAG', 'error');
  } finally {
    if (btnSubmit) btnSubmit.disabled = false;
    if (btnSubmitText) btnSubmitText.textContent = 'Phân tích & Lập chiến lược';
    refreshIcons();
  }
}

function renderExtractedIntent(intent) {
  const intentCard = document.getElementById('ai-intent-card');
  const intentTags = document.getElementById('ai-intent-tags');
  if (!intentCard || !intentTags) return;

  intentCard.classList.remove('hidden');

  const badges = [
    { label: 'Điểm xét tuyển', value: intent.student_score ? `${intent.student_score} điểm` : 'Chưa rõ', color: 'bg-azure text-white font-bold' },
    { label: 'Khối thi', value: intent.student_group_code || 'A00/D01', color: 'bg-navy text-white font-bold' },
    { label: 'Khu vực', value: intent.preferred_city || 'Toàn quốc', color: 'bg-mist text-ink border border-line' },
    { label: 'Ngân sách học phí', value: intent.max_annual_budget ? `< ${formatVND(intent.max_annual_budget)}/năm` : 'Không giới hạn', color: 'bg-mist text-ink border border-line' },
    { label: 'Mã Holland suy luận', value: `${intent.inferred_holland_code || 'RIA'} (RIASEC)`, color: 'bg-emerald-100 text-emerald-800 font-semibold' },
  ];

  intentTags.innerHTML = badges.map((b) => `
    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full ${b.color}">
      <span class="opacity-75">${b.label}:</span>
      <span>${b.value}</span>
    </span>
  `).join('');
}

function renderStrategicPortfolio(portfolio) {
  const card = document.getElementById('ai-portfolio-card');
  const reachList = document.getElementById('list-reach');
  const targetList = document.getElementById('list-target');
  const safeList = document.getElementById('list-safe');
  const countReach = document.getElementById('count-reach');
  const countTarget = document.getElementById('count-target');
  const countSafe = document.getElementById('count-safe');

  if (!card) return;
  card.classList.remove('hidden');

  const reachItems = portfolio.reach || [];
  const targetItems = portfolio.target || [];
  const safeItems = portfolio.safe || [];

  if (countReach) countReach.textContent = reachItems.length;
  if (countTarget) countTarget.textContent = targetItems.length;
  if (countSafe) countSafe.textContent = safeItems.length;

  const renderTierCards = (items, tierType) => {
    if (!items || items.length === 0) {
      return `<p class="text-xs text-muted italic py-4 text-center">Chưa có nguyện vọng phù hợp cho nhóm này.</p>`;
    }

    return items.map((p, idx) => {
      const margin = p.score_margin !== undefined ? p.score_margin : 0;
      const marginFormatted = margin >= 0 ? `+${margin.toFixed(2)}` : margin.toFixed(2);
      const marginColor = margin >= 2.0 ? 'text-emerald-700 bg-emerald-100' : margin >= 0 ? 'text-azure bg-blue-100' : 'text-amber-800 bg-amber-100';
      const companies = (p.top_jobs_market && p.top_jobs_market.length > 0) ? p.top_jobs_market : (p.hiring_companies || []).slice(0, 3);

      return `
        <div class="rounded-[16px] bg-card p-4 shadow-sm border border-line hover:shadow-md transition-all">
          <div class="flex items-start justify-between gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-navy/10 text-navy">${p.university_short_name || p.university_id}</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold ${marginColor}">Biên độ: ${marginFormatted}đ</span>
          </div>
          <h5 class="font-display text-xs sm:text-sm font-bold text-ink leading-snug line-clamp-1" title="${p.program_name}">${p.program_name}</h5>
          <p class="text-[11px] text-muted line-clamp-1 mt-0.5" title="${p.university_name}">${p.university_name}</p>

          <div class="mt-2.5 pt-2 border-t border-line/60 grid grid-cols-2 gap-2 text-[11px]">
            <div>
              <span class="text-muted block text-[10px]">Điểm chuẩn:</span>
              <span class="font-bold text-ink">${p.benchmark_score ? p.benchmark_score.toFixed(2) : 'N/A'}</span>
            </div>
            <div>
              <span class="text-muted block text-[10px]">Học phí thực tế:</span>
              <span class="font-bold text-ink">${p.actual_tuition ? formatVND(p.actual_tuition) : 'Chuẩn'}</span>
            </div>
          </div>

          <!-- CareerViet tags -->
          ${companies.length > 0 ? `
            <div class="mt-2.5 pt-2 border-t border-line/40">
              <span class="text-[10px] text-muted block mb-1 flex items-center gap-1">
                <i data-lucide="briefcase" class="size-2.5 text-cyan"></i> Tuyển dụng CareerViet:
              </span>
              <div class="flex flex-wrap gap-1">
                ${companies.map((c) => `<span class="px-1.5 py-0.5 rounded text-[9px] bg-mist text-ink border border-line line-clamp-1" title="${c}">${c.slice(0, 22)}${c.length > 22 ? '...' : ''}</span>`).join('')}
              </div>
            </div>
          ` : ''}

          <div class="mt-2 text-right">
            <span class="text-[10px] font-mono text-muted">MCDM: ${(p.mcdm_score || 0).toFixed(3)}</span>
          </div>
        </div>
      `;
    }).join('');
  };

  if (reachList) reachList.innerHTML = renderTierCards(reachItems, 'Reach');
  if (targetList) targetList.innerHTML = renderTierCards(targetItems, 'Target');
  if (safeList) safeList.innerHTML = renderTierCards(safeItems, 'Safe');
  refreshIcons();
}

// --- BOOTSTRAP ---
window.addEventListener('DOMContentLoaded', async () => {
  initTheme();
  initMobileMenu();
  initDetailModal();
  await loadAllData();
  await initAuth();

  window.addEventListener('hashchange', renderRoute);
  renderRoute();
});
