          <div class="flex-1 min-w-0">
            <h1 class="font-display text-2xl sm:text-3xl font-bold text-navy leading-tight">${sd.name}</h1>
            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-ice text-navy font-semibold border border-azure/20">
