          ${sr.dgnl ? `<div class="p-3 rounded-[14px] bg-blue-50 border border-blue-200/60 text-xs"><span class="font-bold text-blue-800">📊 ĐGNL/ĐGTD:</span><p class="mt-1 text-blue-700 whitespace-pre-line">${sr.dgnl.replace(/Điểm ĐG[^:]*:\s*/gi,'').split('\\n').join('\n')}</p></div>` : ''}
          ${sr.combined ? `<div class="p-3 rounded-[14px] bg-purple-50 border border-purple-200/60 text-xs"><span class="font-bold text-purple-800">🔗 Kết hợp:</span><p class="mt-1 text-purple-700 whitespace-pre-line">${sr.combined.split('\\n').join('\n')}</p></div>` : ''}
          ${sr.hocba ? `<div class="p-3 rounded-[14px] bg-amber-50 border border-amber-200/60 text-xs"><span class="font-bold text-amber-800">📚 Học bạ:</span><p class="mt-1 text-amber-700 whitespace-pre-line">${sr.hocba.split('\\n').join('\n')}</p></div>` : ''}
        </div>
      </div>
      ` : ''}

      <!-- Programs Table -->
      <div class="rounded-[20px] bg-card p-5 sm:p-6 shadow-border border border-line">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-5">
          <h3 class="font-display text-lg font-bold text-navy flex items-center gap-2">
            <i data-lucide="list" class="size-5 text-azure"></i>
            Bảng ngành đào tạo & Điểm chuẩn 2026
