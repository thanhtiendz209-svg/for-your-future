              <span class="text-xs font-normal text-muted" id="ai-prompt-length">0 ký tự</span>
            </label>
            <textarea
              id="ai-prompt-input"
              rows="3"
              class="w-full rounded-[16px] border border-line bg-mist/60 dark:bg-mist/20 p-4 text-sm sm:text-base text-ink placeholder:text-muted/60 focus:border-azure focus:bg-card focus:outline-none focus:ring-2 focus:ring-azure/20 transition-all resize-none"
              placeholder="VD: Em được 25.5 điểm khối A00, thích IT hoặc Khoa học máy tính ở TP.HCM, ngân sách học phí khoảng 30-40 triệu/năm..."
            >${initialPrompt}</textarea>

            <!-- Quick Suggestion Chips -->
