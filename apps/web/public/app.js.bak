            <div class="rounded-[var(--radius-lg)] bg-card/70 px-3.5 py-3 shadow-border">
              <dt class="font-display text-xl font-semibold tabular-nums text-navy">136</dt>
              <dd class="text-xs text-muted mt-0.5">nhóm MBTI & RIASEC</dd>
