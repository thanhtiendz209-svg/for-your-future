function renderSchoolProgramRows(programs, searchQuery, methodFilter) {
  let filtered = programs;

  if (searchQuery) {
    const q = searchQuery.toLowerCase();
    filtered = filtered.filter((p) =>
      p.name.toLowerCase().includes(q) ||
      p.code.toLowerCase().includes(q) ||
      (p.combinations || '').toLowerCase().includes(q)
    );
  }

  if (methodFilter === 'Tiêu chuẩn') {
    filtered = filtered.filter((p) => (p.type || '').includes('Tiêu chuẩn'));
  } else if (methodFilter === 'Chương trình') {
    filtered = filtered.filter((p) => (p.type || '').includes('Chương trình') || (p.type || '').includes('khác'));
  }

  if (filtered.length === 0) {
    return `<tr><td colspan="7" class="text-center py-8 text-muted italic">Không tìm thấy ngành phù hợp.</td></tr>`;
  }

  return filtered.map((p, i) => {
    const isAdvanced = (p.type || '').includes('Chương trình') || (p.name || '').includes('tiên tiến') || (p.name || '').includes('CT ');
    const rowBg = i % 2 === 0 ? '' : 'bg-mist/30';
    const typeBadge = isAdvanced
      ? `<span class="ml-1.5 px-1.5 py-0.5 rounded text-[9px] bg-purple-100 text-purple-700 font-semibold whitespace-nowrap">Đặc biệt</span>`
      : '';

    const fmtScore = (v) => {
      if (v === null || v === undefined) return '<span class="text-muted">—</span>';
      return `<span class="font-bold tabular-nums">${Number(v).toFixed(2)}</span>`;
    };

    return `
      <tr class="border-b border-line/40 hover:bg-ice/50 transition ${rowBg}">
        <td class="py-2.5 px-2 text-muted tabular-nums">${i + 1}</td>
        <td class="py-2.5 px-2 font-mono font-semibold text-navy">${p.code}</td>
        <td class="py-2.5 px-2">
          <span class="font-semibold text-ink">${p.name}</span>${typeBadge}
        </td>
        <td class="py-2.5 px-2 text-muted">${(p.combinations || '').replace(/;\s*/g, ', ').slice(0, 35)}${(p.combinations || '').length > 35 ? '…' : ''}</td>
        <td class="py-2.5 px-2 text-right text-emerald-700">${fmtScore(p.scores?.thpt)}</td>
        <td class="py-2.5 px-2 text-right text-blue-700">${fmtScore(p.scores?.dgtd)}</td>
        <td class="py-2.5 px-2 text-right text-purple-700">${fmtScore(p.scores?.combined)}</td>
      </tr>
    `;
  }).join('');
}

function attachSchoolDetailEvents(sd) {
  const searchInput = document.getElementById('sd-search');
  const methodSelect = document.getElementById('sd-method-filter');
  const tbody = document.getElementById('sd-programs-tbody');
  const countLabel = document.getElementById('sd-count-label');

  function applyFilter() {
    const q = searchInput ? searchInput.value.trim() : '';
    const m = methodSelect ? methodSelect.value : 'Tất cả';
    state.schoolProgramFilter = q;
    state.schoolProgramMethod = m;
    if (tbody) {
      tbody.innerHTML = renderSchoolProgramRows(sd.programs, q, m);
      const shown = tbody.querySelectorAll('tr:not([colspan])').length || tbody.querySelectorAll('tr').length;
      if (countLabel) countLabel.textContent = `Hiển thị ${shown} / ${sd.programs.length} dòng`;
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', applyFilter);
    searchInput.value = state.schoolProgramFilter || '';
  }
  if (methodSelect) {
    methodSelect.addEventListener('change', applyFilter);
    methodSelect.value = state.schoolProgramMethod || 'Tất cả';
  }
}

window.renderSchoolProgramRows = renderSchoolProgramRows;


