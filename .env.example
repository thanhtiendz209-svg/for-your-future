# For Your Future - Environment Variables
APP_NAME="For Your Future"
PROJECT_NAME="for-your-future"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="for_your_future_secure_jwt_secret_key_minimum_32_bytes_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL (Aiven Cloud)
DATABASE_URL="postgresql://avnadmin:your_aiven_password_here@pg-1a5f2827-thanhtiendz209-1f86.b.aivencloud.com:26350/defaultdb?sslmode=require"
ASYNC_DATABASE_URL="postgresql+asyncpg://avnadmin:your_aiven_password_here@pg-1a5f2827-thanhtiendz209-1f86.b.aivencloud.com:26350/defaultdb"

# Neo4j Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"
NEO4J_DATABASE="neo4j"

# Ollama Inference Engine
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT_SECONDS=45

# Google Gemini AI (Optional / Alternative LLM)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-flash-lite-latest"

